<clickhouse>
    <remote_servers>
        <opik>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </opik>
    </remote_servers>
    <zookeeper>
        <node index="1">
            <host>zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
    <macros>
        <shard>1</shard>
        <replica>1</replica>
        <cluster>opik</cluster>
    </macros>
</clickhouse>
