<clickhouse>
    <!--
        ClickHouse 25.8 made the experimental Time/Time64 type opt-in.
        Opik migration 000030_add_project_configs_table creates a Time column
        (dropped later by 000036), so fresh installs need this enabled to
        replay the migration chain without errors.
        This is a profile-level (per-user) setting.
    -->
    <profiles>
        <default>
            <allow_experimental_time_time64_type>1</allow_experimental_time_time64_type>
        </default>
    </profiles>
</clickhouse>
