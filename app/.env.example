# Model policy: this system runs on gpt-4o-mini (chat, fast tasks and OCR
# transcription) and text-embedding-3-large (embeddings), both on Azure, and
# nothing else. The app refuses to start with any other provider or deployment
# (config.enforce_model_policy).
LLM_PROVIDER=azure
EMBEDDING_PROVIDER=azure

# AZURE
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_FAST_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
# Embeddings may live on a separate resource; both default to the chat values.
# AZURE_EMBEDDING_API_KEY=
# AZURE_EMBEDDING_ENDPOINT=

# OCR — set path to Tesseract if not on system PATH (Windows example below)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR engine: "tesseract" (default) or "azure_vision" (sends scanned pages to
# the gpt-4o-mini deployment for transcription instead)
# OCR_ENGINE=azure_vision

# Azure AI Foundry project — optional, only used by eval/run_eval.py to log
# evaluation runs to the Foundry dashboard.
# AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# The house's own entities, comma-separated (matched against recorded parties).
# Lets "our data processing agreements" mean the ones a house entity signed.
# Leave empty to read "our" as every document of the type.
HOUSE_PARTIES=

# Party-name words so common they identify no document (a shared group name),
# lower-case, comma-separated. Excluded from name matching.
COMMON_PARTY_TOKENS=
