LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENROUTER_API_KEY_WIKI=your-wiki-key-here
OPENROUTER_API_KEY_RAG=your-rag-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# OCR — set path to Tesseract if not on system PATH (Windows example below)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR engine: "tesseract" (default) or "azure_vision" (sends scanned pages to
# the Azure OpenAI deployment for transcription instead — requires LLM_PROVIDER=azure)
# OCR_ENGINE=azure_vision


# # AZURE
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536

# # Azure AI Foundry project — optional, only used by eval/run_eval.py to log
# # evaluation runs to the Foundry dashboard. Pops a browser login (tenant-pinned)
# # the first time it's needed each run.
# AZURE_AI_PROJECT_ENDPOINT=https://bruprod-5274-resource.services.ai.azure.com/api/projects/bruprod-5274
# AZURE_TENANT_ID=ecc10205-f141-4018-bbf8-1c14fc7a5123