# =============================================================================
# Legal Wiki — Environment Configuration
# Copy this file to .env and fill in your values.
# Only one provider (openrouter OR azure) needs to be configured at a time.
# =============================================================================

# Active provider: "openrouter" or "azure"
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter

# =============================================================================
# OPTION A: OpenRouter
# =============================================================================

OPENROUTER_API_KEY=your-openrouter-api-key-here

# Big model — ingest synthesis, answer generation, compare narrative, drafting
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Fast/cheap model — page selection, contradiction checks, JSON repair, cell extraction
OPENROUTER_FAST_MODEL=openai/gpt-oss-20b:free

# Embedding model
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# =============================================================================
# OPTION B: Azure OpenAI
# Uncomment and fill in all lines below, comment out the OpenRouter block above.
# =============================================================================

# LLM_PROVIDER=azure
# EMBEDDING_PROVIDER=azure

# AZURE_OPENAI_API_KEY=your-azure-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Big model — ingest synthesis, answer generation, compare narrative, drafting
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Fast/cheap model — page selection, contradiction checks, JSON repair, cell extraction
# AZURE_FAST_DEPLOYMENT=gpt-5.4-mini

# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Concurrency
# =============================================================================

# Number of parallel workers for wiki segment processing per document (default: 3)
# WIKI_MAX_WORKERS=3

# =============================================================================
# OCR (Optional)
# Required only if processing scanned / image-based PDFs.
# Set to the path of your Tesseract executable if it is not on your system PATH.
# =============================================================================

# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# =============================================================================
# Server
# =============================================================================

# PORT=5001
