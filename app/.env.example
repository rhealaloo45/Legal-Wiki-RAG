LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENROUTER_API_KEY_WIKI=your-wiki-key-here
OPENROUTER_API_KEY_RAG=your-rag-key-here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# OCR — set path to Tesseract if not on system PATH (Windows example below)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe


# # AZURE
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2025-01-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536

# ── Opik self-hosted LLM tracing & evaluation ──────────────────────────────────
# Start the Opik stack:  docker compose -f docker-compose.opik.yml up -d
# UI available at:       http://localhost:5173
#
# Point the app at the local Opik backend.
# On Docker Desktop (Windows/Mac), use host.docker.internal to reach services
# running on the host from inside a container.
# OPIK_URL_OVERRIDE=http://host.docker.internal:8080
# OPIK_PROJECT_NAME=legal-wiki-rag